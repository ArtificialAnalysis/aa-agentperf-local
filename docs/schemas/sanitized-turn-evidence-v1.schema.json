{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artificialanalysis.ai/schemas/agentperf-local/sanitized-turn-evidence-v1.schema.json",
  "title": "AgentPerf Local sanitized turn evidence v1 experimental",
  "description": "Ordinal-only timing, token, pacing, and action-count evidence. This local preview is not an upload authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "privacy_profile",
    "normalization_policy_id",
    "aggregate_payload_digest",
    "source_turns_digest",
    "rows_digest",
    "turns",
    "excluded_private_categories",
    "status"
  ],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "agentperf_local_sanitized_turn_evidence" },
    "privacy_profile": { "const": "sanitized-turn-evidence-v1-experimental" },
    "normalization_policy_id": { "const": "observed-decode-time-v1" },
    "aggregate_payload_digest": { "$ref": "#/$defs/digest" },
    "source_turns_digest": { "$ref": "#/$defs/digest" },
    "rows_digest": { "$ref": "#/$defs/digest" },
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/turn" }
    },
    "excluded_private_categories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "const": "source task, turn, and conversation identifiers" },
        { "const": "prompts, model responses, and reasoning" },
        { "const": "tool names, arguments, outputs, commands, and exception text" },
        { "const": "endpoint URLs, credentials, paths, and environment values" },
        { "const": "hostnames, serial numbers, UUIDs, and raw hardware output" },
        { "const": "raw cache namespaces, challenge secrets, and process data" }
      ],
      "items": false
    },
    "status": { "const": "experimental-local-preview-no-upload" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "e2e_latency_ms",
        "time_to_first_byte_ms",
        "time_to_first_token_ms",
        "generation_ms"
      ],
      "properties": {
        "e2e_latency_ms": { "type": "number", "minimum": 0, "maximum": 86400000 },
        "time_to_first_byte_ms": { "type": "number", "minimum": 0, "maximum": 86400000 },
        "time_to_first_token_ms": { "type": "number", "minimum": 0, "maximum": 86400000 },
        "generation_ms": { "type": "number", "minimum": 0, "maximum": 86400000 }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_prompt_tokens",
        "server_output_tokens",
        "local_output_tokens",
        "observed_output_tokens",
        "target_output_tokens"
      ],
      "properties": {
        "server_prompt_tokens": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "server_output_tokens": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "local_output_tokens": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "server_cached_prompt_tokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 10000000
        },
        "server_uncached_prompt_tokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 10000000
        },
        "observed_output_tokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "target_output_tokens": { "type": "integer", "minimum": 1, "maximum": 10000000 }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_ordinal",
        "task_ordinal",
        "turn_in_task",
        "finish_reason",
        "response_chunks",
        "response_action_count",
        "recorded_action_count",
        "recorded_pacing_ms",
        "replayed_pacing_ms",
        "timing",
        "tokens"
      ],
      "properties": {
        "turn_ordinal": { "type": "integer", "minimum": 0 },
        "task_ordinal": { "type": "integer", "minimum": 0 },
        "turn_in_task": { "type": "integer", "minimum": 0 },
        "finish_reason": { "type": "string", "minLength": 1 },
        "response_chunks": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "response_action_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "recorded_action_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "recorded_pacing_ms": { "type": "number", "minimum": 0, "maximum": 86400000 },
        "replayed_pacing_ms": { "type": "number", "minimum": 0, "maximum": 86400000 },
        "timing": { "$ref": "#/$defs/timing" },
        "tokens": { "$ref": "#/$defs/tokens" }
      }
    }
  }
}
