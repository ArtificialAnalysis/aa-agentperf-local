{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artificialanalysis.ai/schemas/agentperf-local/recipe-v2.schema.json",
  "title": "agentperf-local managed-run recipe v2",
  "$ref": "#/$defs/model",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+\\-]*[A-Za-z0-9])?$"
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9._+\\-]*[A-Za-z0-9_])?(?:/[A-Za-z0-9_](?:[A-Za-z0-9._+\\-]*[A-Za-z0-9_])?)*$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "device_id": {
      "enum": [
        "nvidia-cuda",
        "amd-rocm",
        "apple-silicon"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "filename": {
          "$ref": "#/$defs/artifact_path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "source_repository": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/repository"
            }
          ]
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/revision"
            }
          ]
        }
      }
    },
    "llama_cpp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_size",
        "ubatch_size",
        "target_backend_sampling",
        "draft_backend_sampling"
      ],
      "properties": {
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "ubatch_size": {
          "type": "integer",
          "minimum": 1
        },
        "speculative_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "draft_model_filename": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/artifact_path"
            }
          ]
        },
        "target_backend_sampling": {
          "type": "boolean"
        },
        "draft_backend_sampling": {
          "type": "boolean"
        },
        "backend": {
          "enum": [
            null,
            "rocm",
            "vulkan",
            "metal"
          ]
        },
        "load_mode": {
          "enum": [
            null,
            "none",
            "mmap"
          ]
        },
        "lazy_mode": {
          "enum": [
            null,
            "on-direct"
          ]
        },
        "threads": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "flash_attention": {
          "type": "boolean"
        },
        "disable_fit": {
          "type": "boolean"
        },
        "cache_ram_mib": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "context_checkpoints": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "vllm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arguments"
      ],
      "properties": {
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "memory": {
      "description": "Attention shape and fixed reserves, so the memory floor can be recomputed for any served context. Every reserve is read from the runtime's own startup accounting at the benchmark context.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_attention_layers",
        "full_kv_heads",
        "full_kv_head_dimension",
        "sliding_attention_layers",
        "sliding_kv_heads",
        "sliding_kv_head_dimension",
        "sliding_cached_tokens",
        "kv_bytes_per_scalar",
        "recurrent_state_slots",
        "constant_state_bytes",
        "runtime_overhead_bytes"
      ],
      "properties": {
        "full_attention_layers": {
          "type": "integer",
          "minimum": 0
        },
        "sliding_attention_layers": {
          "type": "integer",
          "minimum": 0
        },
        "sliding_cached_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Tokens each sliding-attention layer keeps. This is what the runtime caches, not only the model's window: llama.cpp keeps the window, SGLang keeps a share of the token pool."
        },
        "kv_bytes_per_scalar": {
          "type": "integer",
          "minimum": 1
        },
        "recurrent_state_slots": {
          "type": "integer",
          "minimum": 0,
          "description": "Recurrent-state slots the runtime may hold, zero for a model without recurrent layers. SGLang is launched with exactly this many so one card's free memory cannot size the pool."
        },
        "constant_state_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes those recurrent-state slots occupy together, measured at startup."
        },
        "runtime_overhead_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Everything else the device holds at readiness: loaded weights over the artifact bytes, compute and graph buffers, and the runtime's own context."
        },
        "full_kv_heads": {
          "type": "integer",
          "minimum": 0,
          "description": "KV heads a full-attention layer keeps; Gemma 4 holds a different shape here than in its sliding layers."
        },
        "full_kv_head_dimension": {
          "type": "integer",
          "minimum": 0
        },
        "sliding_kv_heads": {
          "type": "integer",
          "minimum": 0
        },
        "sliding_kv_head_dimension": {
          "type": "integer",
          "minimum": 0
        },
        "lazy_read_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Artifact bytes the runtime reads from disk on demand and never holds resident; the memory floor leaves them out. Non-zero only for a llama.cpp recipe with a lazy_mode."
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "artifacts",
        "context_tokens",
        "frameworks",
        "memory"
      ],
      "properties": {
        "artifact_kind": {
          "enum": [
            "gguf-single-file",
            "gguf-file-set",
            "safetensors-repository"
          ]
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "context_tokens": {
          "const": 65536
        },
        "frameworks": {
          "type": "array",
          "items": {
            "enum": [
              "llama-cpp",
              "sglang",
              "vllm"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 2
        },
        "memory": {
          "$ref": "#/$defs/memory"
        },
        "model_filename": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/artifact_path"
            }
          ]
        },
        "llama_cpp": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/llama_cpp"
            }
          ]
        },
        "vllm": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/vllm"
            }
          ]
        },
        "runtime_versions": {
          "description": "The release each framework is verified against for this profile, keyed by framework. A framework with no comparable release version (llama.cpp) is omitted. The launcher refuses every other version.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "sglang",
              "vllm"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+|[0-9]+\\.[0-9]+\\.dev[0-9]+\\+g[0-9a-f]{7,40})$"
          }
        },
        "moe_runner_backend": {
          "description": "The fused-expert kernel this recipe is served with, or null when it has no mixture-of-experts layers or the runtime's own choice is known to serve it. Only an SGLang recipe may name one.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "flashinfer_cutlass"
              ]
            }
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "as_of",
        "model_name",
        "quantization",
        "hf_repository",
        "hf_revision",
        "devices",
        "tool_call_parser",
        "reasoning_parser",
        "thinking_policy",
        "speculation_policy",
        "deployment"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "model_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "quantization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "hf_repository": {
          "$ref": "#/$defs/repository"
        },
        "hf_revision": {
          "$ref": "#/$defs/revision"
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/device_id"
          }
        },
        "tool_call_parser": {
          "enum": [
            "gemma4",
            "glm45",
            "gpt-oss",
            "qwen3_coder",
            "qwen3_xml"
          ]
        },
        "reasoning_parser": {
          "enum": [
            "gemma4",
            "gpt-oss",
            "nemotron_v3",
            "qwen3"
          ]
        },
        "thinking_policy": {
          "enum": [
            "disabled",
            "enabled",
            "enabled-medium-candidate"
          ]
        },
        "speculation_policy": {
          "enum": [
            "disabled-target-only-baseline",
            "enabled-mtp-self-draft",
            "enabled-mtp-external-draft",
            "enabled-dflash-external-draft",
            "enabled-dflash-draft",
            "enabled-dspark-external-draft",
            "enabled-dspark-draft",
            "enabled-vllm-external-draft"
          ]
        },
        "deployment": {
          "$ref": "#/$defs/deployment"
        }
      }
    }
  }
}
